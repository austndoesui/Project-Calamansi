diff --git a/bsd/kern/mach_loader.c b/bsd/kern/mach_loader.c
--- a/bsd/kern/mach_loader.c
+++ b/bsd/kern/mach_loader.c
@@ -642,6 +642,9 @@
 	/*
 	 * Check to see if the page zero is enforced by the map->min_offset.
 	 */
+#if defined(CACTUS)
+	cactus_pid1_loader_status("PID1 pagezero begin", 0);
+#endif
 	if (enforce_hard_pagezero &&
 	    (vm_map_has_hard_pagezero(map, 0x1000) == FALSE)) {
 #if __arm64__
@@ -674,7 +677,13 @@
 	}
 #endif
 
+#if defined(CACTUS)
+	cactus_pid1_loader_status("PID1 pagezero pass", 0);
+#endif
 	vm_commit_pagezero_status(map);
+#if defined(CACTUS)
+	cactus_pid1_loader_status("PID1 pagezero commit", 0);
+#endif
 
 	/*
 	 * If this is an exec, then we are going to destroy the old
@@ -702,7 +711,13 @@
 		 * that may have been left behind by the workqueue threads
 		 * as they exited (and then clean up the work queue itself).
 		 */
+#if defined(CACTUS)
+		cactus_pid1_loader_status("PID1 task halt start", 0);
+#endif
 		kret = task_start_halt(task);
+#if defined(CACTUS)
+		cactus_pid1_loader_status("PID1 task halt result", (int)kret);
+#endif
 		if (kret != KERN_SUCCESS) {
 			vm_map_deallocate(map); /* will lose pmap reference too */
 			return LOAD_FAILURE;
@@ -710,6 +725,9 @@
 		proc_transcommit(p, 0);
 		workq_mark_exiting(p);
 		task_complete_halt(task);
+#if defined(CACTUS)
+		cactus_pid1_loader_status("PID1 task halt complete", 0);
+#endif
 		workq_exit(p);
 
 		/*
@@ -720,6 +738,9 @@
 		task_rollup_accounting_info(get_threadtask(thread), task);
 	}
 	*mapp = map;
+#if defined(CACTUS)
+	cactus_pid1_loader_status("PID1 map assigned", 0);
+#endif
 
 #if __has_feature(ptrauth_calls) && defined(XNU_TARGET_OS_OSX)
 	/*
@@ -740,6 +761,9 @@
 #endif /* __has_feature(ptrauth_calls) && defined(XNU_TARGET_OS_OSX) */
 
 
+#if defined(CACTUS)
+	cactus_pid1_loader_status("PID1 load_machfile done", 0);
+#endif
 	return LOAD_SUCCESS;
 }
 
