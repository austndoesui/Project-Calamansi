diff --git a/bsd/kern/mach_loader.c b/bsd/kern/mach_loader.c
--- a/bsd/kern/mach_loader.c
+++ b/bsd/kern/mach_loader.c
@@ -95,6 +95,20 @@
 
 #include "kern_exec_internal.h"
 
+#if defined(CACTUS)
+extern void fbcon_stage53_progress(const char *);
+static void
+cactus_pid1_loader_status(const char *phase, int code)
+{
+	proc_t p = current_proc();
+	if (p != PROC_NULL && proc_pid(p) == 1) {
+		char status[80];
+		snprintf(status, sizeof(status), "ST82 %s=%d", phase, code);
+		fbcon_stage53_progress(status);
+	}
+}
+#endif
