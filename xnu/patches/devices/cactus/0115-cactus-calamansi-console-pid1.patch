 /*
- * Update the fixed status line without allocating, printing or taking a
- * lock. Called during single-CPU kernel bringup before threaded logging.
- * Restores the scroll cursor so normal output continues uninterrupted.
- */
+ * Ring of the last twelve native XNU checkpoints. No allocations, no
+ * spinlocks, no USB dependency. Always render the newest event at the bottom,
+ * while the normal XNU serial console wraps ABOVE the fixed panel.
+ */
+static int
+calamansi_contains(const char *haystack, const char *needle)
+{
+    for (; *haystack; haystack++) {
+        const char *a = haystack, *b = needle;
+        while (*a && *b && *a == *b) { a++; b++; }
+        if (!*b) return 1;
+    }
+    return 0;
+}
+
+static void
+calamansi_panel_line(uint32_t row, const char *prefix, const char *msg)
+{
+    fbcon_clear_row(row);
+    fbcon_row = row;
+    fbcon_col = 0;
+    fbcon_literal(prefix);
+    if (msg != NULL) {
+        while (*msg && fbcon_col + 1 < fbcon_cols) {
+            fbcon_transmit_data((uint8_t)*msg++);
+        }
+    }
+}
+
+static void
+calamansi_panel_redraw(void)
+{
+    if (fbcon_log_end_row <= FBCON_HEADER_ROWS ||
+        fbcon_log_end_row + FBCON_PANEL_ROWS > fbcon_rows ||
+        calamansi_panel_busy) return;
+    calamansi_panel_busy = 1;
+    const uint32_t old_row = fbcon_row, old_col = fbcon_col;
+    uint32_t base = fbcon_log_end_row;
+    calamansi_panel_line(base, "------ CALAMANSI | LIVE XNU EVENTS ------", NULL);
+    uint32_t newest = (calamansi_event_pos + FBCON_EVENT_ROWS - 1u)
+        % FBCON_EVENT_ROWS;
+    calamansi_panel_line(base + 1u, "LAST   ",
+        calamansi_event_count ? calamansi_events[newest] : "waiting for XNU");
+    calamansi_panel_line(base + 2u, "ERROR  ",
+        calamansi_last_error[0] ? calamansi_last_error : "none");
+    calamansi_panel_line(base + 3u, "SEQ    newest event is at the bottom", NULL);
+    for (uint32_t i = 0; i < FBCON_EVENT_ROWS; i++) {
+        uint32_t skip = FBCON_EVENT_ROWS - calamansi_event_count;
+        const char *msg = NULL;
+        if (i >= skip) {
+            uint32_t slot = (calamansi_event_pos + i) % FBCON_EVENT_ROWS;
+            msg = calamansi_events[slot];
+        }
+        calamansi_panel_line(base + 4u + i, msg ? " > " : "   ", msg);
+    }
+    fbcon_row = old_row;
+    fbcon_col = old_col;
+    calamansi_panel_busy = 0;
+}
+
+static void
+calamansi_append_event(const char *message)
+{
+    char *dest = calamansi_events[calamansi_event_pos];
+    uint32_t i = 0;
+    while (i + 1u < FBCON_EVENT_CHARS && message[i]) {
+        dest[i] = message[i];
+        i++;
+    }
+    dest[i] = 0;
+    if (calamansi_contains(dest, "ERROR") ||
+        calamansi_contains(dest, "failed") ||
+        calamansi_contains(dest, "FAILED") ||
+        calamansi_contains(dest, "panic") ||
+        calamansi_contains(dest, "timeout")) {
+        uint32_t n = 0;
+        while (n + 1u < FBCON_EVENT_CHARS && dest[n]) {
+            calamansi_last_error[n] = dest[n];
+            n++;
+        }
+        calamansi_last_error[n] = 0;
+    }
+    calamansi_event_pos = (calamansi_event_pos + 1u) % FBCON_EVENT_ROWS;
+    if (calamansi_event_count < FBCON_EVENT_ROWS)
+        calamansi_event_count++;
+    calamansi_event_sequence++;
+}
