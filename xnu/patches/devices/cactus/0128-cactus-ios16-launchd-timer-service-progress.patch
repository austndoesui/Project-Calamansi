diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -382,6 +382,30 @@
     __builtin_arm_dsb(DSB_SY);
     __builtin_arm_isb(ISB_SY);
 }
+
+/* BSD uses timed waits to start launchd services.  If a late GIC change
+ * disables the architected timer PPI, restore the original CPU0 routing.
+ * Read-only on the normal, already-enabled path. */
+int
+cactus_vtimer_repair_if_needed(void)
+{
+    if (!gicd_base || !gicr_base || ml_get_cpu_number_local() != 0) {
+        return -1;
+    }
+    vm_offset_t gicr_pe_base = find_gicr_pe_base();
+    const uint32_t mask = 1U << sweet_vtimer_intid;
+    if (gicr_read32(GICR_ISENABLER0) & mask) {
+        return 0;
+    }
+    if (gicr_read32(GICR_WAKER) & GICR_WAKER_CHILDRENASLEEP) {
+        return -2;
+    }
+    uint32_t group = gicr_read32(GICR_IGROUPR0);
+    gicr_write32(GICR_IGROUPR0, group | mask);
+    gicr_write32(GICR_ISENABLER0, mask);
+    __builtin_arm_dsb(DSB_SY);
+    return (gicr_read32(GICR_ISENABLER0) & mask) ? 1 : -3;
+}
 #endif
 
 #else
