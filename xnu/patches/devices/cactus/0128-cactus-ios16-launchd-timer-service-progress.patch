+volatile unsigned int cactus_vtimer_irq_count;
 #endif
 void
 sleh_irq(arm_saved_state_t *state)
@@ -1900,6 +1901,9 @@
 		return; /* spurious */
 	}
 	if (intid == sweet_vtimer_intid) {
+#if defined(CACTUS)
+		__atomic_fetch_add(&cactus_vtimer_irq_count, 1U, __ATOMIC_RELAXED);
+#endif
 		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_TIMER);
 		cdp->cpu_decrementer = -1; /* Large */
 		INTERRUPT_MASKED_DEBUG_START(rtclock_intr, DBG_INTR_TYPE_TIMER);
