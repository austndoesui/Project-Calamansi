diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -63,26 +63,37 @@
 static void
 sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 {
 	static int chan;
+	int first = 5, period = 10;
 	if (!PE_parse_boot_argn("sweetsample", sweet_sample_names, sizeof(sweet_sample_names))) {
-		strlcpy(sweet_sample_names, "SpringBoard,backboardd", sizeof(sweet_sample_names));
+		strlcpy(sweet_sample_names, "launchd,backboardd,SpringBoard,mobileactivationd", sizeof(sweet_sample_names));
 	}
 	if (sweet_sample_names[0] == '-') {
 		return;
 	}
-	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
-	for (int i = 0; i < 40; i++) {
+	(void)PE_parse_boot_argn("sweetsample_first", &first, sizeof(first));
+	(void)PE_parse_boot_argn("sweetsample_period", &period, sizeof(period));
+	if (first < 1 || first > 120) first = 5;
+	if (period < 1 || period > 120) period = 10;
+	printf("CACTUS IOS16: sampling %s first=%ds period=%ds\n",
+	    sweet_sample_names, first, period);
+	(void)tsleep(&chan, PZERO, "sweetsmp", first * hz);
+	for (int i = 0; i < 60; i++) {
 		printf("SMP --- sample %d\n", i);
 		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
-		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
+		(void)tsleep(&chan, PZERO, "sweetsmp", period * hz);
 	}
 }
+
+static bool sweet_sample_started;
 
 void
 sweet_sample_start(void)
 {
 	thread_t thread;
+	if (sweet_sample_started) return;
 	if (kernel_thread_start(sweet_sample_thread, NULL, &thread) == KERN_SUCCESS) {
+		sweet_sample_started = true;
 		thread_deallocate(thread);
 	}
 }
