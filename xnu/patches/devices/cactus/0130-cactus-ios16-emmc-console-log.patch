+/* The Stage92/97 filesystem occupies the first 16 GiB of userdata.
+ * A SWEETLOG-compatible 4 MiB + 4 KiB log lives only beyond that end.
+ * Never allow debug writes onto formatted HFS+ or other partitions. */
+#define CACTUS_TRACE_MIN_SECTORS (0x2000000u + 1025u * 8u)
+int
+cactus_trace_write(uint32_t sector_offset, const void *data, uint32_t sectors)
+{
+    if (!cactus_initialized || !cactus_writable ||
+        strcmp(cactus_root_name, "userdata") != 0 ||
+        cactus_root_count < CACTUS_TRACE_MIN_SECTORS ||
+        sector_offset < 0x2000000u || sectors == 0 ||
+        sectors > 128u || sector_offset > cactus_root_count ||
+        sector_offset >= CACTUS_TRACE_MIN_SECTORS ||
+        sectors > CACTUS_TRACE_MIN_SECTORS - sector_offset ||
+        sectors > cactus_root_count - sector_offset) {
+        return EROFS;
+    }
+    return cactus_write_blocks(cactus_root_first + sector_offset,
+        (const uint8_t *)data, sectors);
+}
